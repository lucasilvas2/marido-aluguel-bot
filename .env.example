# Configuração do WhatsApp Web

## Variáveis de Ambiente

# Porta da aplicação
PORT=3000

# Configurações do Prisma
# Credenciais devem corresponder ao docker-compose.yml
DATABASE_URL="mysql://root:root@localhost:3306/marido_aluguel"

# Configurações do WhatsApp (opcional)
WHATSAPP_SESSION_PATH="./whatsapp-session"

# Limitação de números em desenvolvimento (opcional)
# Lista de números de telefone permitidos a interagir com o bot
# Formato: números separados por vírgula, sem espaços ou com espaços
# Exemplo: DEV_ALLOWED_NUMBERS="5511999999999,5511888888888"
# Se não definido ou vazio, todos os números serão permitidos
# DEV_ALLOWED_NUMBERS=""
